# ---------------------------------------------------------------------------
# Every variable here must behave identically as a Codespaces secret and as a
# Vercel environment variable. Nothing multi-line: keys are base64-encoded.
# ---------------------------------------------------------------------------

# --- Database roles ---------------------------------------------------------
# Four connections, each with the least it needs. Nothing in the application
# uses anything but the app and auth roles.

# Administrative. Creates the roles. Used by `bootstrap` and `reset` only.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/zeeraa

# Owns the schema. Migrations and seeds. NOSUPERUSER and NOBYPASSRLS, so FORCE
# ROW LEVEL SECURITY binds it — a psql session here reads nothing until it opens
# the maintenance gate deliberately.
DATABASE_URL_OWNER=postgres://zeeraa_owner:zeeraa_owner@localhost:5433/zeeraa

# The runtime connection. Must be the RLS-constrained role, never the owner.
# The application refuses to start otherwise.
DATABASE_URL_APP=postgres://zeeraa_app:zeeraa_app@localhost:5433/zeeraa

# The Auth.js adapter. Identity tables only; no tenant-scoped table at all.
DATABASE_URL_AUTH=postgres://zeeraa_auth:zeeraa_auth@localhost:5433/zeeraa

# Ingestion. Scoped to a tenant but not to a user — a sync writes on nobody's
# behalf — and reaching only the tables ingestion writes.
DATABASE_URL_JOBS=postgres://zeeraa_jobs_runner:zeeraa_jobs_runner@localhost:5433/zeeraa

# Backfill scripts and psql sessions. Member of zeeraa_maintenance, so it can
# open the gate — but only inside a transaction that sets app.maintenance.
DATABASE_URL_MAINT=postgres://zeeraa_maint:zeeraa_maint@localhost:5433/zeeraa

# Passwords used by `pnpm --filter @zeeraa/db bootstrap` when creating the roles.
OWNER_ROLE_PASSWORD=
JOBS_ROLE_PASSWORD=
APP_ROLE_PASSWORD=
AUTH_ROLE_PASSWORD=
MAINT_ROLE_PASSWORD=

# 32-byte key, base64. Encrypts the `connections.credentials` blob (AES-256-GCM).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Auth.js -----------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=no-reply@zeeraa.com

# --- Salesforce (JWT bearer flow) -------------------------------------------
SF_CLIENT_ID=
# The integration user's Salesforce username — the JWT's `sub` claim. Not their
# email address, and not necessarily a working mailbox. Absent from §14 of the
# brief; the flow cannot authenticate without it. See docs/brief-amendments.md.
SF_USERNAME=
# base64 of the whole PEM file. PEM newlines get mangled in env vars; decode at
# runtime. This is the single most common cause of JWT flow failures.
SF_PRIVATE_KEY_BASE64=
SF_LOGIN_URL=https://login.salesforce.com

# --- Ad platforms ------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Jobs, storage, delivery -------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
